{
  "$schema": "https://turbo.build/schema.json",

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "build/**"
      ]
    },

    "dev": {
      "cache": false,
      "persistent": true
    },

    "start": {
      "cache": false
    },

    "lint": {
      "dependsOn": ["^lint"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"]
    },

    "test": {
      "dependsOn": ["build"],
      "outputs": [
        "coverage/**"
      ]
    },

    "clean": {
      "cache": false
    }
  }
}