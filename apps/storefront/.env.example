# Server-only Storefront API origin.
STOREFRONT_API_BASE_URL=http://localhost:4000/api/v1

# Server-only deployment binding. Must match the API Store bootstrap key.
COMMERCE_STORE_KEY=fardad

# Server-only proof shared with the API runtime. Never prefix this value with NEXT_PUBLIC_.
COMMERCE_BFF_SHARED_SECRET=replace-with-a-unique-commerce-bff-secret-of-at-least-32-bytes

# Exact Media origin used by Next Image. Local development may use the API loopback origin.
# Production must provide a separately approved HTTPS origin; leave unset until approved.
STOREFRONT_MEDIA_ORIGIN=http://localhost:4000/api/v1
