# API runtime environment. Keep real credentials out of version control.
NODE_ENV=development
API_PORT=4000

# Use a distinct database and credential set for each environment.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/fardad_development?schema=public

# Authentication secrets must be unique per environment and at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-unique-refresh-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15

# Server-derived commerce partition. Never accept this value from browser input.
COMMERCE_STORE_KEY=fardad

# Server-only proof shared with the Storefront runtime. Generate a unique value of at least 32 bytes.
COMMERCE_BFF_SHARED_SECRET=replace-with-a-unique-commerce-bff-secret-of-at-least-32-bytes

# Media delivery is provider-independent. Keep disabled until local or approved public delivery is configured.
MEDIA_DELIVERY_MODE=disabled

# For local development only, set MEDIA_DELIVERY_MODE=local, use an absolute path outside Storefront public assets,
# and expose the API through the loopback origin below. Do not commit a machine-specific root.
MEDIA_LOCAL_ROOT=
MEDIA_PUBLIC_ORIGIN=http://localhost:4000/api/v1
