generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OtpPurpose {
  LOGIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductPublicationState {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNPUBLISHED
}

enum ProductLevel {
  ECONOMIC
  STANDARD
  LUXURY
  SUPER_LUXURY
  VIP
  LIMITED_EDITION
}

enum ProductLabelType {
  NEW
  FEATURED
  BEST_SELLER
  MANAGER_RECOMMENDATION
  CAMPAIGN
}

enum ProductMediaType {
  MAIN_IMAGE
  GALLERY_IMAGE
  DETAIL_IMAGE
  PACKAGING_IMAGE
  LIFESTYLE_IMAGE
  VIDEO_REFERENCE
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaLifecycleStatus {
  PENDING
  READY
  FAILED
  QUARANTINED
  RETIRED
}

enum MediaRenditionVariant {
  CARD
  GALLERY
  DETAIL
  THUMBNAIL
}

enum ProductAttributeDataType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTI_SELECT
  COLOR
  MEASUREMENT
  DATE
}

enum ProductChecklistCategory {
  BASIC_INFORMATION
  CLASSIFICATION
  TECHNICAL_SPECIFICATIONS
  MEDIA
  SEO
}

enum ProductChecklistCompletionSource {
  AUTOMATED
  MANUAL
}

enum CommerceExtensionStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductConfigurationStatus {
  DRAFT
  COMPLETED
  ABANDONED
  EXPIRED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum CommerceCurrency {
  IRR
}

enum ProductOfferStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductOfferSalesMode {
  ONLINE
  PRICE_HIDDEN
  INQUIRY_ONLY
}

enum ProductOfferAvailability {
  AVAILABLE_TO_ORDER
  UNAVAILABLE
}

enum CartStatus {
  ACTIVE
  EXPIRED
}

enum CartMutationKind {
  ADD_LINE
  SET_LINE_QUANTITY
  REMOVE_LINE
  REFRESH_QUOTE
}

enum CommerceAuditActorType {
  SYSTEM
  GUEST
}

enum CommerceAuditEventType {
  STORE_CREATED
  OFFER_CREATED
  OFFER_ACTIVATED
  OFFER_DEACTIVATED
  CART_CREATED
  CART_LINE_ADDED
  CART_LINE_QUANTITY_SET
  CART_LINE_REMOVED
  CART_QUOTE_REFRESHED
  CART_EXPIRED
}

enum CommerceAuditSubjectType {
  STORE
  PRODUCT_OFFER
  CART
  CART_LINE
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  email                  String                   @unique @db.VarChar(320)
  isActive               Boolean                  @default(true) @map("is_active")
  passwordCredential     PasswordCredential?
  roleAssignments        UserRole[]
  sessions               AuthSession[]
  checklistStatuses      ProductChecklistStatus[]
  mediaAssetsCreated     MediaAsset[]             @relation("MediaAssetCreatedBy")
  mediaAssetsUpdated     MediaAsset[]             @relation("MediaAssetUpdatedBy")
  mediaRenditionsCreated MediaRendition[]         @relation("MediaRenditionCreatedBy")
  mediaRenditionsUpdated MediaRendition[]         @relation("MediaRenditionUpdatedBy")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  deletedAt              DateTime?                @map("deleted_at")

  @@map("users")
}

model Product {
  id                String                   @id @default(uuid()) @db.Uuid
  name              String?                  @db.VarChar(255)
  englishName       String?                  @map("english_name") @db.VarChar(255)
  slug              String?                  @unique @db.VarChar(255)
  shortDescription  String?                  @map("short_description") @db.Text
  description       String?                  @db.Text
  productType       String?                  @map("product_type") @db.VarChar(100)
  level             ProductLevel?
  status            ProductStatus            @default(DRAFT)
  publicationState  ProductPublicationState  @default(DRAFT) @map("publication_state")
  metaTitle         String?                  @map("meta_title") @db.VarChar(255)
  metaDescription   String?                  @map("meta_description") @db.VarChar(500)
  categoryId        String?                  @map("category_id") @db.Uuid
  publishedAt       DateTime?                @map("published_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  deletedAt         DateTime?                @map("deleted_at")
  category          ProductCategory?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attributeValues   ProductAttributeValue[]
  checklistStatuses ProductChecklistStatus[]
  addonServices     ProductAddonService[]
  bundleRules       ProductBundleRule[]
  configurations    ProductConfiguration[]
  giftBoxes         ProductGiftBox[]
  logistics         ProductLogistics?
  labels            ProductLabel[]
  media             ProductMedia[]
  offers            ProductOffer[]
  cartLines         CartLine[]

  @@index([categoryId, status])
  @@index([publicationState])
  @@map("products")
}

model Store {
  id                          String               @id @default(uuid()) @db.Uuid
  key                         String               @unique @db.VarChar(100)
  profileKey                  String               @map("profile_key") @db.VarChar(100)
  displayName                 String               @map("display_name") @db.VarChar(255)
  status                      StoreStatus          @default(INACTIVE)
  currency                    CommerceCurrency     @default(IRR)
  quoteTtlSeconds             Int                  @default(900) @map("quote_ttl_seconds")
  guestCartIdleTtlSeconds     Int                  @default(2592000) @map("guest_cart_idle_ttl_seconds")
  guestCartAbsoluteTtlSeconds Int                  @default(7776000) @map("guest_cart_absolute_ttl_seconds")
  maxCartLines                Int                  @default(50) @map("max_cart_lines")
  maxLineQuantity             Int                  @default(99) @map("max_line_quantity")
  version                     Int                  @default(1)
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")
  offers                      ProductOffer[]
  carts                       Cart[]
  auditEvents                 CommerceAuditEvent[]

  @@index([status])
  @@map("stores")
}

model ProductOffer {
  id              String                   @id @default(uuid()) @db.Uuid
  storeId         String                   @map("store_id") @db.Uuid
  productId       String                   @map("product_id") @db.Uuid
  version         Int
  status          ProductOfferStatus       @default(DRAFT)
  salesMode       ProductOfferSalesMode    @map("sales_mode")
  availability    ProductOfferAvailability @default(UNAVAILABLE)
  priceAmountRial BigInt?                  @map("price_amount_rial") @db.BigInt
  currency        CommerceCurrency         @default(IRR)
  minQuantity     Int                      @default(1) @map("min_quantity")
  maxQuantity     Int                      @map("max_quantity")
  effectiveFrom   DateTime                 @map("effective_from")
  effectiveUntil  DateTime?                @map("effective_until")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  store           Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product         Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartLines       CartLine[]

  @@unique([id, storeId])
  @@unique([storeId, productId, version])
  @@index([storeId, productId, status])
  @@index([storeId, status, effectiveFrom, effectiveUntil])
  @@map("product_offers")
}

model Cart {
  id                 String               @id @default(uuid()) @db.Uuid
  storeId            String               @map("store_id") @db.Uuid
  tokenHash          Bytes                @unique @map("token_hash") @db.ByteA
  status             CartStatus           @default(ACTIVE)
  revision           Int                  @default(1)
  currency           CommerceCurrency     @default(IRR)
  subtotalAmountRial BigInt               @default(0) @map("subtotal_amount_rial") @db.BigInt
  quoteFingerprint   Bytes?               @map("quote_fingerprint") @db.ByteA
  quotedAt           DateTime?            @map("quoted_at")
  quoteExpiresAt     DateTime?            @map("quote_expires_at")
  lastActivityAt     DateTime             @default(now()) @map("last_activity_at")
  expiresAt          DateTime             @map("expires_at")
  absoluteExpiresAt  DateTime             @map("absolute_expires_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  store              Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  lines              CartLine[]
  mutations          CartMutationRecord[]

  @@unique([id, storeId])
  @@index([storeId, status, expiresAt])
  @@index([storeId, lastActivityAt])
  @@map("carts")
}

model CartLine {
  id                     String       @id @default(uuid()) @db.Uuid
  publicReference        String       @unique @map("public_reference") @db.VarChar(22)
  storeId                String       @map("store_id") @db.Uuid
  cartId                 String       @map("cart_id") @db.Uuid
  productId              String       @map("product_id") @db.Uuid
  offerId                String       @map("offer_id") @db.Uuid
  offerVersion           Int          @map("offer_version")
  equivalenceKey         Bytes        @map("equivalence_key") @db.ByteA
  quantity               Int
  productSlugSnapshot    String       @map("product_slug_snapshot") @db.VarChar(255)
  productNameSnapshot    String       @map("product_name_snapshot") @db.VarChar(255)
  unitPriceAmountRial    BigInt       @map("unit_price_amount_rial") @db.BigInt
  lineSubtotalAmountRial BigInt       @map("line_subtotal_amount_rial") @db.BigInt
  quoteExpiresAt         DateTime     @map("quote_expires_at")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  cart                   Cart         @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Cascade)
  product                Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  offer                  ProductOffer @relation(fields: [offerId, storeId], references: [id, storeId], onDelete: Restrict)

  @@unique([cartId, equivalenceKey])
  @@index([storeId, cartId])
  @@index([storeId, offerId])
  @@index([productId])
  @@map("cart_lines")
}

model CartMutationRecord {
  id                String           @id @default(uuid()) @db.Uuid
  storeId           String           @map("store_id") @db.Uuid
  cartId            String           @map("cart_id") @db.Uuid
  kind              CartMutationKind
  keyHash           Bytes            @map("key_hash") @db.ByteA
  requestHash       Bytes            @map("request_hash") @db.ByteA
  resultingRevision Int              @map("resulting_revision")
  createdAt         DateTime         @default(now()) @map("created_at")
  expiresAt         DateTime         @map("expires_at")
  cart              Cart             @relation(fields: [cartId, storeId], references: [id, storeId], onDelete: Cascade)

  @@unique([storeId, keyHash])
  @@index([storeId, cartId, createdAt])
  @@index([expiresAt])
  @@map("cart_mutation_records")
}

model CommerceAuditEvent {
  id               String                   @id @default(uuid()) @db.Uuid
  storeId          String                   @map("store_id") @db.Uuid
  eventType        CommerceAuditEventType   @map("event_type")
  subjectType      CommerceAuditSubjectType @map("subject_type")
  subjectReference String                   @map("subject_reference") @db.VarChar(64)
  actorType        CommerceAuditActorType   @map("actor_type")
  requestId        String?                  @map("request_id") @db.VarChar(100)
  cartRevision     Int?                     @map("cart_revision")
  occurredAt       DateTime                 @default(now()) @map("occurred_at")
  store            Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([storeId, occurredAt])
  @@index([storeId, subjectType, subjectReference, occurredAt])
  @@index([requestId])
  @@map("commerce_audit_events")
}

model GiftBox {
  id             String                  @id @default(uuid()) @db.Uuid
  name           String                  @db.VarChar(255)
  description    String?                 @db.Text
  material       String?                 @db.VarChar(255)
  dimensions     String?                 @db.VarChar(100)
  length         Decimal?                @db.Decimal(12, 2)
  width          Decimal?                @db.Decimal(12, 2)
  height         Decimal?                @db.Decimal(12, 2)
  weight         Decimal?                @db.Decimal(12, 2)
  dimensionUnit  String                  @default("CM") @map("dimension_unit") @db.Char(3)
  weightUnit     String                  @default("KG") @map("weight_unit") @db.Char(3)
  price          Decimal                 @db.Decimal(18, 2)
  currency       String                  @default("IRR") @db.Char(3)
  status         CommerceExtensionStatus @default(DRAFT)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  images         GiftBoxMedia[]
  configurations ProductConfiguration[]
  productOptions ProductGiftBox[]

  @@index([status])
  @@map("gift_boxes")
}

model GiftBoxMedia {
  id             String   @id @default(uuid()) @db.Uuid
  giftBoxId      String   @map("gift_box_id") @db.Uuid
  mediaReference String   @map("media_reference") @db.VarChar(500)
  altText        String?  @map("alt_text") @db.VarChar(500)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  giftBox        GiftBox  @relation(fields: [giftBoxId], references: [id], onDelete: Cascade)

  @@unique([giftBoxId, mediaReference])
  @@index([giftBoxId, sortOrder])
  @@map("gift_box_media")
}

model AddonService {
  id                  String                             @id @default(uuid()) @db.Uuid
  name                String                             @db.VarChar(255)
  description         String?                            @db.Text
  type                String                             @db.VarChar(100)
  configurationSchema Json?                              @map("configuration_schema") @db.JsonB
  price               Decimal                            @db.Decimal(18, 2)
  currency            String                             @default("IRR") @db.Char(3)
  status              CommerceExtensionStatus            @default(DRAFT)
  createdAt           DateTime                           @default(now()) @map("created_at")
  updatedAt           DateTime                           @updatedAt @map("updated_at")
  configurationItems  ProductConfigurationAddonService[]
  productOptions      ProductAddonService[]

  @@index([status, type])
  @@map("addon_services")
}

model ProductGiftBox {
  productId String   @map("product_id") @db.Uuid
  giftBoxId String   @map("gift_box_id") @db.Uuid
  isDefault Boolean  @default(false) @map("is_default")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  giftBox   GiftBox  @relation(fields: [giftBoxId], references: [id], onDelete: Restrict)

  @@id([productId, giftBoxId])
  @@index([giftBoxId])
  @@map("product_gift_boxes")
}

model ProductAddonService {
  productId      String       @map("product_id") @db.Uuid
  addonServiceId String       @map("addon_service_id") @db.Uuid
  isDefault      Boolean      @default(false) @map("is_default")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  addonService   AddonService @relation(fields: [addonServiceId], references: [id], onDelete: Restrict)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, addonServiceId])
  @@index([addonServiceId])
  @@map("product_addon_services")
}

model ProductConfiguration {
  id                  String                             @id @default(uuid()) @db.Uuid
  productId           String                             @map("product_id") @db.Uuid
  giftBoxId           String?                            @map("gift_box_id") @db.Uuid
  personalizationData Json?                              @map("personalization_data") @db.JsonB
  externalReference   String?                            @unique @map("external_reference") @db.VarChar(100)
  status              ProductConfigurationStatus         @default(DRAFT)
  expiresAt           DateTime?                          @map("expires_at")
  createdAt           DateTime                           @default(now()) @map("created_at")
  updatedAt           DateTime                           @updatedAt @map("updated_at")
  addonServices       ProductConfigurationAddonService[]
  giftBox             GiftBox?                           @relation(fields: [giftBoxId], references: [id], onDelete: SetNull)
  product             Product                            @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@index([expiresAt])
  @@map("product_configurations")
}

model ProductConfigurationAddonService {
  configurationId   String               @map("configuration_id") @db.Uuid
  addonServiceId    String               @map("addon_service_id") @db.Uuid
  configurationData Json?                @map("configuration_data") @db.JsonB
  createdAt         DateTime             @default(now()) @map("created_at")
  addonService      AddonService         @relation(fields: [addonServiceId], references: [id], onDelete: Restrict)
  configuration     ProductConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@id([configurationId, addonServiceId])
  @@index([addonServiceId])
  @@map("product_configuration_addon_services")
}

model ProductBundleRule {
  id                  String                  @id @default(uuid()) @db.Uuid
  productId           String?                 @map("product_id") @db.Uuid
  code                String                  @unique @db.VarChar(150)
  name                String                  @db.VarChar(255)
  description         String?                 @db.Text
  conditionDefinition Json                    @map("condition_definition") @db.JsonB
  actionDefinition    Json                    @map("action_definition") @db.JsonB
  priority            Int                     @default(0)
  status              CommerceExtensionStatus @default(DRAFT)
  startsAt            DateTime?               @map("starts_at")
  endsAt              DateTime?               @map("ends_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  product             Product?                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status, priority])
  @@index([startsAt, endsAt])
  @@map("product_bundle_rules")
}

model ProductLogistics {
  productId           String   @id @map("product_id") @db.Uuid
  length              Decimal? @db.Decimal(12, 2)
  width               Decimal? @db.Decimal(12, 2)
  height              Decimal? @db.Decimal(12, 2)
  weight              Decimal? @db.Decimal(12, 2)
  packageLength       Decimal? @map("package_length") @db.Decimal(12, 2)
  packageWidth        Decimal? @map("package_width") @db.Decimal(12, 2)
  packageHeight       Decimal? @map("package_height") @db.Decimal(12, 2)
  packageWeight       Decimal? @map("package_weight") @db.Decimal(12, 2)
  finalShippingWeight Decimal? @map("final_shipping_weight") @db.Decimal(12, 2)
  dimensionUnit       String   @default("CM") @map("dimension_unit") @db.Char(3)
  weightUnit          String   @default("KG") @map("weight_unit") @db.Char(3)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_logistics")
}

model ProductExperienceEventDefinition {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(150)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  payloadSchema   Json?    @map("payload_schema") @db.JsonB
  isAnonymousOnly Boolean  @default(true) @map("is_anonymous_only")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("product_experience_event_definitions")
}

model ProductCategory {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String                 @db.VarChar(255)
  slug                  String                 @unique @db.VarChar(255)
  description           String?                @db.Text
  parentId              String?                @map("parent_id") @db.Uuid
  sortOrder             Int                    @default(0) @map("sort_order")
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  parent                ProductCategory?       @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              ProductCategory[]      @relation("ProductCategoryTree")
  attributeRequirements CategoryAttribute[]
  checklistRules        ProductChecklistRule[]
  products              Product[]

  @@index([parentId, sortOrder])
  @@map("product_categories")
}

model ProductAttributeGroup {
  id          String             @id @default(uuid()) @db.Uuid
  code        String             @unique @db.VarChar(100)
  name        String             @db.VarChar(255)
  description String?            @db.Text
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  attributes  ProductAttribute[]

  @@map("product_attribute_groups")
}

model ProductAttribute {
  id                   String                   @id @default(uuid()) @db.Uuid
  groupId              String?                  @map("group_id") @db.Uuid
  code                 String                   @unique @db.VarChar(100)
  name                 String                   @db.VarChar(255)
  dataType             ProductAttributeDataType @map("data_type")
  unit                 String?                  @db.VarChar(50)
  isFilterable         Boolean                  @default(false) @map("is_filterable")
  sortOrder            Int                      @default(0) @map("sort_order")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  group                ProductAttributeGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  categoryRequirements CategoryAttribute[]
  values               ProductAttributeValue[]

  @@index([groupId, sortOrder])
  @@map("product_attributes")
}

model CategoryAttribute {
  categoryId  String           @map("category_id") @db.Uuid
  attributeId String           @map("attribute_id") @db.Uuid
  isRequired  Boolean          @default(false) @map("is_required")
  sortOrder   Int              @default(0) @map("sort_order")
  category    ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

model ProductAttributeValue {
  id          String           @id @default(uuid()) @db.Uuid
  productId   String           @map("product_id") @db.Uuid
  attributeId String           @map("attribute_id") @db.Uuid
  value       Json             @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId])
  @@map("product_attribute_values")
}

model ProductLabel {
  productId String           @map("product_id") @db.Uuid
  label     ProductLabelType
  createdAt DateTime         @default(now()) @map("created_at")
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, label])
  @@index([label])
  @@map("product_labels")
}

model ProductMedia {
  id             String           @id @default(uuid()) @db.Uuid
  productId      String           @map("product_id") @db.Uuid
  mediaReference String           @map("media_reference") @db.VarChar(500)
  mediaAssetId   String?          @map("media_asset_id") @db.Uuid
  type           ProductMediaType
  altText        String?          @map("alt_text") @db.VarChar(500)
  title          String?          @db.VarChar(255)
  sortOrder      Int              @default(0) @map("sort_order")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset?      @relation(fields: [mediaAssetId, mediaReference], references: [id, reference], onDelete: Restrict)

  @@unique([productId, mediaReference])
  @@index([productId, type, sortOrder])
  @@index([mediaAssetId])
  @@map("product_media")
}

model MediaAsset {
  id                       String               @id @default(uuid(7)) @db.Uuid
  reference                String               @unique @db.VarChar(45)
  publicId                 String               @unique @map("public_id") @db.VarChar(22)
  kind                     MediaKind
  visibility               MediaVisibility
  status                   MediaLifecycleStatus
  verifiedMimeType         String               @map("verified_mime_type") @db.VarChar(100)
  byteSize                 BigInt               @map("byte_size")
  width                    Int?
  height                   Int?
  checksum                 String               @db.Char(64)
  originalStorageReference String               @map("original_storage_reference") @db.VarChar(1024)
  contentVersion           Int                  @default(1) @map("content_version")
  createdById              String?              @map("created_by_id") @db.Uuid
  updatedById              String?              @map("updated_by_id") @db.Uuid
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  deletedAt                DateTime?            @map("deleted_at")
  createdBy                User?                @relation("MediaAssetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                User?                @relation("MediaAssetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  productMedia             ProductMedia[]
  renditions               MediaRendition[]

  @@unique([id, reference])
  @@index([kind, status])
  @@index([visibility, status, deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("media_assets")
}

model MediaRendition {
  id               String                @id @default(uuid(7)) @db.Uuid
  mediaAssetId     String                @map("media_asset_id") @db.Uuid
  variant          MediaRenditionVariant
  contentVersion   Int                   @map("content_version")
  storageReference String                @map("storage_reference") @db.VarChar(1024)
  verifiedMimeType String                @map("verified_mime_type") @db.VarChar(100)
  byteSize         BigInt                @map("byte_size")
  width            Int
  height           Int
  checksum         String                @db.Char(64)
  status           MediaLifecycleStatus
  createdById      String?               @map("created_by_id") @db.Uuid
  updatedById      String?               @map("updated_by_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  deletedAt        DateTime?             @map("deleted_at")
  mediaAsset       MediaAsset            @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  createdBy        User?                 @relation("MediaRenditionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User?                 @relation("MediaRenditionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([mediaAssetId, variant, contentVersion])
  @@index([mediaAssetId, status, deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("media_renditions")
}

model ProductChecklistRule {
  id                 String                   @id @default(uuid()) @db.Uuid
  categoryId         String?                  @map("category_id") @db.Uuid
  code               String                   @unique @db.VarChar(150)
  name               String                   @db.VarChar(255)
  description        String?                  @db.Text
  category           ProductChecklistCategory
  weight             Decimal                  @db.Decimal(5, 2)
  isRequired         Boolean                  @default(true) @map("is_required")
  isCritical         Boolean                  @default(false) @map("is_critical")
  isActive           Boolean                  @default(true) @map("is_active")
  sortOrder          Int                      @default(0) @map("sort_order")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  categoryDefinition ProductCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  statuses           ProductChecklistStatus[]

  @@index([categoryId, isActive, sortOrder])
  @@map("product_checklist_rules")
}

model ProductChecklistStatus {
  id                String                           @id @default(uuid()) @db.Uuid
  productId         String                           @map("product_id") @db.Uuid
  ruleId            String                           @map("rule_id") @db.Uuid
  isCompleted       Boolean                          @default(false) @map("is_completed")
  source            ProductChecklistCompletionSource @default(AUTOMATED)
  completedByUserId String?                          @map("completed_by_user_id") @db.Uuid
  completedAt       DateTime?                        @map("completed_at")
  evaluatedAt       DateTime                         @default(now()) @map("evaluated_at")
  createdAt         DateTime                         @default(now()) @map("created_at")
  updatedAt         DateTime                         @updatedAt @map("updated_at")
  completedBy       User?                            @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)
  product           Product                          @relation(fields: [productId], references: [id], onDelete: Cascade)
  rule              ProductChecklistRule             @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([productId, ruleId])
  @@index([ruleId, isCompleted])
  @@map("product_checklist_statuses")
}

model Role {
  id                    String           @id @default(uuid()) @db.Uuid
  code                  String           @unique @db.VarChar(100)
  description           String?          @db.VarChar(500)
  isSystem              Boolean          @default(false) @map("is_system")
  userAssignments       UserRole[]
  permissionAssignments RolePermission[]
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(150)
  description     String?          @db.VarChar(500)
  roleAssignments RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model PasswordCredential {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  deviceName    String?        @map("device_name") @db.VarChar(100)
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  expiresAt     DateTime       @map("expires_at")
  revokedAt     DateTime?      @map("revoked_at")
  lastUsedAt    DateTime       @default(now()) @map("last_used_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime    @map("expires_at")
  revokedAt DateTime?   @map("revoked_at")
  createdAt DateTime    @default(now()) @map("created_at")
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpRequest {
  id          String     @id @default(uuid()) @db.Uuid
  mobile      String     @db.VarChar(32)
  codeHash    String     @map("code_hash") @db.Char(64)
  purpose     OtpPurpose @default(LOGIN)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  requestedIp String?    @map("requested_ip") @db.VarChar(45)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([mobile, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}
